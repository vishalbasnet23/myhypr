/* Master Config — Caelestia Flat (matches quickshell/caelestia's live M3 scheme) */

/* ---- Configuration ---- */
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "Apps";
    display-run:                "Run";
    display-filebrowser:        "Files";
    display-window:             "Windows";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    dpi:                        1;
}

/* ---- Caelestia M3 Color Palette ----
   Pulled from ~/.local/state/caelestia/scheme.json (catppuccin mocha / expressive).
   This is the SAME palette the quickshell bar, dashboard, notifications and
   session menu read live — rofi can't subscribe to the JSON directly (rasi has
   no variable sharing across formats), so these are restated here. Re-copy the
   relevant hex values from scheme.json if you change wallpaper/scheme. */
* {
    base:           #131317;
    mantle:         #0e0e12;
    crust:          #121216;

    text:           #e5e1e7;
    subtext0:       #918f9a;
    subtext1:       #c8c5d1;

    surface0:       #25252a;
    surface1:       #37373d;
    surface2:       #48474e;

    overlay0:       #595860;
    overlay1:       #6b6972;
    overlay2:       #7e7c86;

    blue:           #b0b8ff;
    lavender:       #c7c8ff;
    sapphire:       #b7c5ff;
    sky:            #d0daff;
    teal:           #d3dfff;
    green:          #c8e3ff;
    yellow:         #ffecf3;
    peach:          #e0c2f9;
    maroon:         #c9b5ed;
    red:            #ffb4ab;
    mauve:          #bfb8ff;
    pink:           #e2d7ff;
    flamingo:       #e9def3;
    rosewater:      #f7eff9;

    /* ---- Flat surface roles + neutral text ramp ----
       No blur/glass treatment — flat fills only, matching the shell's
       rounding.scale: 0 / deformScale: 0 flat-design pass. */
    wb-text-glass:  #e5e1e7;
    wb-dim:         rgba(200, 197, 209, 55%);
    wb-faint:       rgba(229, 225, 231, 28%);
    glass-fill:     rgba(19, 19, 23, 92%);
    glass-border:   rgba(145, 143, 154, 30%);
    glass-raised:   rgba(229, 225, 231, 6%);
    ui-hover:       rgba(229, 225, 231, 10%);
    sel:            #c2c1ff;
    sel-lite:       #e2dfff;
    sel-fill:       rgba(194, 193, 255, 20%);

    /* Semantic roles */
    text-color:                  @wb-text-glass;
    background-color:            transparent;
    border-color:                @glass-border;
}

/* ---- Window ---- */
window {
    enabled:                    true;
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    spacing:                    0px;

    /* Glass — the pane itself. Hyprland blurs namespace "rofi"; without that
       layerrule this is a flat translucent slab. */
    border:                     1px;
    border-color:               @glass-border;
    border-radius:              0px;

    location:                   center;
    anchor:                     center;
    width:                      42%;
    background-color:           @glass-fill;
}

/* ---- Mainbox ---- */
mainbox {
    padding:                    16px;
    enabled:                    true;
    orientation:                vertical;
    spacing:                    10px;
    children:                   [ "inputbar", "listbox" ];
    background-color:           transparent;

    /* The window carries the hairline now — a second border here would
       double it up. */
    border:                     0px;
    border-radius:              0px;
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                    true;
    padding:                    10px 14px;
    margin:                     0px 0px 4px 0px;
    border-radius:              0px;

    /* Raised chip on the glass — same treatment as a swaync notification. */
    border:                     0px;
    background-color:           @glass-raised;
    orientation:                horizontal;
    children:                   [ "entry", "dummy", "mode-switcher" ];
}

/* ---- Entry ---- */
entry {
    font:                       "Maple Mono NF CN 13";
    text-color:                 @wb-text-glass;
    enabled:                    true;
    expand:                     false;
    width:                      100%;
    padding:                    2px 0px;
    background-color:           transparent;
    text-color:                 @text;
    cursor:                     text;
    placeholder:                "  Search ";
    placeholder-color:          @wb-dim;
}

/* ---- Listbox ---- */
listbox {
    spacing:                    6px;
    padding:                    0px;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "listview" ];
}

/* ---- Listview ---- */
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    2px;
    background-color:           transparent;
    border:                     0px;
    border-radius:              0px;
}

/* ---- Dummy spacer ---- */
dummy {
    expand:                     true;
    background-color:           transparent;
}

/* ---- Mode Switcher ---- */
mode-switcher {
    enabled:                    true;
    spacing:                    6px;
    background-color:           transparent;
}

/* Uniform chips — the mode you are IN is the only one that carries colour. */
button {
    padding:                    2px 12px;
    border-radius:              0px;
    background-color:           @glass-raised;
    text-color:                 @wb-dim;
    cursor:                     pointer;
    font:                       "Maple Mono NF CN 11";
    border:                     0px;
}

button selected {
    background-color:           @sel-fill;
    text-color:                 @sel-lite;
    border:                     0px 0px 0px 2px;
    border-color:               @sel;
}

/* ---- Scrollbar ---- */
scrollbar {
    width:                      3px;
    border:                     0;
    handle-color:               rgba(255, 255, 255, 25%);
    handle-width:               6px;
    padding:                    0;
    border-radius:              0px;
}

/* ---- Elements ---- */
element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    8px 12px;
    border-radius:              0px;
    background-color:           transparent;
    cursor:                     pointer;

    /* 2px left strip, painted only by state — the same motif as a swaync
       notification card. */
    border:                     0px 0px 0px 2px;
    border-color:               transparent;
}

/* Normal items — no strip until hovered/selected */
element normal.normal {
    background-color:           transparent;
    text-color:                 @text;
    border-color:               transparent;
}
element normal.urgent {
    background-color:           rgba(255, 61, 0, 12%);
    text-color:                 @red;
    border-color:               @red;
}
element normal.active {
    background-color:           rgba(0, 212, 163, 10%);
    text-color:                 @teal;
    border-color:               @teal;
}

/* Selected — copper strip + tinted bg */
element selected.normal {
    background-color:           @sel-fill;
    text-color:                 @wb-text-glass;
    border-color:               @sel;
}
element selected.urgent {
    background-color:           rgba(255, 61, 0, 25%);
    text-color:                 @wb-text-glass;
    border-color:               @red;
}
element selected.active {
    background-color:           rgba(0, 212, 163, 20%);
    text-color:                 @wb-text-glass;
    border-color:               @teal;
}

/* Alternating rows — colourless, just a faint lift so long lists stay
   scannable without introducing a second accent. */
element alternate.normal {
    background-color:           rgba(255, 255, 255, 3%);
    text-color:                 @wb-text-glass;
    border-color:               transparent;
}
element alternate.urgent {
    background-color:           transparent;
    text-color:                 @red;
    border-color:               transparent;
}
element alternate.active {
    background-color:           transparent;
    text-color:                 @teal;
    border-color:               transparent;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       22px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

/* ---- Message / Textbox ---- */
message {
    background-color:           transparent;
    border:                     0px;
    border-radius:              0px;
}

textbox {
    padding:                    8px 12px;
    border-radius:              0px;
    border:                     0px;
    background-color:           @glass-raised;
    text-color:                 @wb-dim;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

error-message {
    padding:                    14px;
    border-radius:              0px;
    border:                     0px 0px 0px 2px;
    border-color:               @red;
    background-color:           rgba(255, 61, 0, 12%);
    text-color:                 @red;
}
