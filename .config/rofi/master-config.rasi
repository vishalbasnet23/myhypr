/* Master Config — Vibrant Glass */

/* ---- Configuration ---- */
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "Apps";
    display-run:                "Run";
    display-filebrowser:        "Files";
    display-window:             "Windows";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    dpi:                        1;
}

/* ---- Vibrant Color Palette ---- */
* {
    base:           #1a1c2c;
    mantle:         #151726;
    crust:          #0f1120;

    text:           #f1f3ff;
    subtext0:       #a9b0d6;
    subtext1:       #c5cbff;

    surface0:       #2c2f48;
    surface1:       #3a3e5c;
    surface2:       #4a4f75;

    overlay0:       #62689a;
    overlay1:       #7a80b2;
    overlay2:       #969dd1;

    blue:           #2979ff;
    lavender:       #8e5cff;
    sapphire:       #00bcd4;
    sky:            #00e5ff;
    teal:           #00d4a3;
    green:          #00e676;
    yellow:         #ffd600;
    peach:          #ff9100;
    maroon:         #ff1744;
    red:            #ff3d00;
    mauve:          #d500f9;
    pink:           #ff4081;
    flamingo:       #ff6e6e;
    rosewater:      #ff8fa3;

    /* ---- Glass roles + neutral text ramp ----
       Same values as waybar's style/Glass.css and swaync's style.css. rasi has
       no variable sharing across formats, so they are restated here.
       NOTE: rasi has no box-shadow, so the glass here is fill + hairline only. */
    wb-text-glass:  #eef2f6;
    wb-dim:         rgba(223, 228, 234, 55%);
    wb-faint:       rgba(255, 255, 255, 28%);
    glass-fill:     rgba(232, 238, 245, 13%);
    glass-border:   rgba(255, 255, 255, 22%);
    glass-raised:   rgba(255, 255, 255, 6%);
    ui-hover:       rgba(255, 255, 255, 10%);
    sel:            #ffffff;
    sel-lite:       #ffffff;
    sel-fill:       rgba(255, 255, 255, 20%);

    /* Semantic roles */
    text-color:                  @wb-text-glass;
    background-color:            transparent;
    border-color:                @glass-border;
}

/* ---- Window ---- */
window {
    enabled:                    true;
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    spacing:                    0px;

    /* Glass — the pane itself. Hyprland blurs namespace "rofi"; without that
       layerrule this is a flat translucent slab. */
    border:                     1px;
    border-color:               @glass-border;
    border-radius:              14px;

    location:                   center;
    anchor:                     center;
    width:                      42%;
    background-color:           @glass-fill;
}

/* ---- Mainbox ---- */
mainbox {
    padding:                    16px;
    enabled:                    true;
    orientation:                vertical;
    spacing:                    10px;
    children:                   [ "inputbar", "listbox" ];
    background-color:           transparent;

    /* The window carries the hairline now — a second border here would
       double it up. */
    border:                     0px;
    border-radius:              0px;
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                    true;
    padding:                    10px 14px;
    margin:                     0px 0px 4px 0px;
    border-radius:              10px;

    /* Raised chip on the glass — same treatment as a swaync notification. */
    border:                     0px;
    background-color:           @glass-raised;
    orientation:                horizontal;
    children:                   [ "entry", "dummy", "mode-switcher" ];
}

/* ---- Entry ---- */
entry {
    font:                       "Maple Mono NF CN 13";
    text-color:                 @wb-text-glass;
    enabled:                    true;
    expand:                     false;
    width:                      100%;
    padding:                    2px 0px;
    background-color:           transparent;
    text-color:                 @text;
    cursor:                     text;
    placeholder:                "  Search ";
    placeholder-color:          @wb-dim;
}

/* ---- Listbox ---- */
listbox {
    spacing:                    6px;
    padding:                    0px;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "listview" ];
}

/* ---- Listview ---- */
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    2px;
    background-color:           transparent;
    border:                     0px;
    border-radius:              0px;
}

/* ---- Dummy spacer ---- */
dummy {
    expand:                     true;
    background-color:           transparent;
}

/* ---- Mode Switcher ---- */
mode-switcher {
    enabled:                    true;
    spacing:                    6px;
    background-color:           transparent;
}

/* Uniform chips — the mode you are IN is the only one that carries colour. */
button {
    padding:                    2px 12px;
    border-radius:              8px;
    background-color:           @glass-raised;
    text-color:                 @wb-dim;
    cursor:                     pointer;
    font:                       "Maple Mono NF CN 11";
    border:                     0px;
}

button selected {
    background-color:           @sel-fill;
    text-color:                 @sel-lite;
    border:                     0px 0px 0px 2px;
    border-color:               @sel;
}

/* ---- Scrollbar ---- */
scrollbar {
    width:                      3px;
    border:                     0;
    handle-color:               rgba(255, 255, 255, 25%);
    handle-width:               6px;
    padding:                    0;
    border-radius:              8px;
}

/* ---- Elements ---- */
element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    8px 12px;
    border-radius:              10px;
    background-color:           transparent;
    cursor:                     pointer;

    /* 2px left strip, painted only by state — the same motif as a swaync
       notification card. */
    border:                     0px 0px 0px 2px;
    border-color:               transparent;
}

/* Normal items — no strip until hovered/selected */
element normal.normal {
    background-color:           transparent;
    text-color:                 @text;
    border-color:               transparent;
}
element normal.urgent {
    background-color:           rgba(255, 61, 0, 12%);
    text-color:                 @red;
    border-color:               @red;
}
element normal.active {
    background-color:           rgba(0, 212, 163, 10%);
    text-color:                 @teal;
    border-color:               @teal;
}

/* Selected — copper strip + tinted bg */
element selected.normal {
    background-color:           @sel-fill;
    text-color:                 @wb-text-glass;
    border-color:               @sel;
}
element selected.urgent {
    background-color:           rgba(255, 61, 0, 25%);
    text-color:                 @wb-text-glass;
    border-color:               @red;
}
element selected.active {
    background-color:           rgba(0, 212, 163, 20%);
    text-color:                 @wb-text-glass;
    border-color:               @teal;
}

/* Alternating rows — colourless, just a faint lift so long lists stay
   scannable without introducing a second accent. */
element alternate.normal {
    background-color:           rgba(255, 255, 255, 3%);
    text-color:                 @wb-text-glass;
    border-color:               transparent;
}
element alternate.urgent {
    background-color:           transparent;
    text-color:                 @red;
    border-color:               transparent;
}
element alternate.active {
    background-color:           transparent;
    text-color:                 @teal;
    border-color:               transparent;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       22px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

/* ---- Message / Textbox ---- */
message {
    background-color:           transparent;
    border:                     0px;
    border-radius:              0px;
}

textbox {
    padding:                    8px 12px;
    border-radius:              10px;
    border:                     0px;
    background-color:           @glass-raised;
    text-color:                 @wb-dim;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

error-message {
    padding:                    14px;
    border-radius:              10px;
    border:                     0px 0px 0px 2px;
    border-color:               @red;
    background-color:           rgba(255, 61, 0, 12%);
    text-color:                 @red;
}
