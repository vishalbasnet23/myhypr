// SEMANTIC  named roles instead of numbers
// Pairs with Hyprland window rules pinning apps to fixed workspaces, so
// the label always matches what is actually there. In the Lua config
// format this version runs (UserConfigs/WindowRules.lua) a pin reads:
//   hl.window_rule({ match = { class = "^(kitty)$" }, workspace = "1" })
//   hl.window_rule({ match = { tag = "browser" },     workspace = "2" })
//   hl.window_rule({ match = { tag = "im" },          workspace = "3" })
// Append ' silent' to the workspace string to pin without following:
//   hl.window_rule({ match = { tag = "multimedia" }, workspace = "4 silent" })
// WindowRules.lua already pins 1/2/3/4/5/8/9/10 - reconcile before use.
"hyprland/workspaces#semantic": {
	"active-only": false,
	"all-outputs": true,
	"format": "{icon}",
	"show-special": false,
	"on-click": "activate",
	"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = [[e+1]] })'",
	"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = [[e-1]] })'",
