		"3": "󰭹 chat",
		"4": " media",
		"5": "󰋁 misc",
	},
},
// STATES  the only variant that defines urgent and special
// Every other variant sets show-special: false and defines no urgent
// glyph, so an attention-demanding window on another workspace is
// currently invisible. This one shows it.
"hyprland/workspaces#states": {
	"active-only": false,
	"all-outputs": true,
	"format": "{icon}",
	"show-special": true,
	"on-click": "activate",
	"on-click-right": "hyprctl dispatch 'hl.dsp.workspace.toggle_special([[nyx]])'",
	"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = [[e+1]] })'",
	"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = [[e-1]] })'",
    "persistent-workspaces": {
      "*": 5
	},
	"format-icons": {
		"active": "",
		"default": "",
		"empty": "",
		"urgent": "",
		"special": "◆",
	},
	// Right click toggles the special:nyx workspace that SUPER+U already
	// uses (configs/Keybinds.lua) and WindowRules.lua sends Discord/Spotify to.
},

