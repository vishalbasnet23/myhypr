pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell

/**
 * The Vibrant Glass design tokens, ported 1:1 from the CSS the rest of the
 * desktop already uses:
 *
 *   waybar/style/custom/vibrant.css  - the raw palette
 *   waybar/style/Glass.css           - how the bar uses it
 *   swaync/style.css                 - how notifications use it
 *   gtk-3.0/vibrant-glass.css        - how GTK apps use it
 *
 * Keep those five in step. This file is the QML copy; it is NOT generated by
 * wallust (the swaync/waybar wallust templates are commented out in
 * wallust.toml, and Glass.css imports style/custom/vibrant.css instead), so
 * changing a colour here changes nothing else.
 */
Singleton {
    id: root

    // ---- Raw palette (vibrant.css) ----
    readonly property color base: "#1a1c2c"
    readonly property color mantle: "#151726"
    readonly property color crust: "#0f1120"

    readonly property color text: "#f1f3ff"
    readonly property color subtext0: "#a9b0d6"
    readonly property color subtext1: "#c5cbff"

    readonly property color surface0: "#2c2f48"
    readonly property color surface1: "#3a3e5c"
    readonly property color surface2: "#4a4f75"

    readonly property color overlay0: "#62689a"
    readonly property color overlay1: "#7a80b2"
    readonly property color overlay2: "#969dd1"

    readonly property color blue: "#2979ff"
    readonly property color lavender: "#8e5cff"
    readonly property color sapphire: "#00bcd4"
    readonly property color sky: "#00e5ff"
    readonly property color teal: "#00d4a3"
    readonly property color green: "#00e676"
    readonly property color yellow: "#ffd600"
    readonly property color peach: "#ff9100"
    readonly property color maroon: "#ff1744"
    readonly property color red: "#ff3d00"
    readonly property color mauve: "#d500f9"

    // ---- Roles (Glass.css) ----
    readonly property color textPrimary: "#dfe4ea"     // @wb-text
    readonly property color textGlass: "#eef2f6"       // @wb-text-glass - on the pill
    // Secondary / disabled. Raised from the 0.70 / 0.40 in DESIGN.md §3 -
    // those were tuned against a near-opaque dark panel, and on the light
    // glass tint they read as grey mud. Subtext1 gives the secondary tier a
    // cooler hue so it separates from primary by more than opacity alone.
    readonly property color textDim: Qt.rgba(197 / 255, 203 / 255, 255 / 255, 0.92)
    readonly property color textDisabled: Qt.rgba(223 / 255, 228 / 255, 234 / 255, 0.55)
    readonly property color textFaint: Qt.rgba(1, 1, 1, 0.45)

    readonly property color accent: blue
    readonly property color accentSoft: lavender
    readonly property color ok: teal
    readonly property color warn: yellow
    readonly property color critical: red

    // The pill: fill, hairline, and the two-layer shadow that reads as glass.
    readonly property color glassFill: Qt.rgba(232 / 255, 238 / 255, 245 / 255, 0.13)
    readonly property color glassBorder: Qt.rgba(1, 1, 1, 0.22)
    // Raised chip ON the bar pill - stays a light lift, because the pill
    // itself is the light tint. Panels use cardLayer instead.
    readonly property color glassRaised: Qt.rgba(1, 1, 1, 0.06)
    readonly property color uiHover: Qt.rgba(1, 1, 1, 0.10)
    readonly property color uiPressed: Qt.rgba(1, 1, 1, 0.16)
    // The lit inset edge, previously inlined in Pill/GlassPanel.
    readonly property color glassHighlight: Qt.rgba(1, 1, 1, 0.10)
    readonly property color uiActive: Qt.rgba(1, 1, 1, 0.20)
    readonly property color sel: "#ffffff"

    // Glass for a panel that floats over ARBITRARY content rather than over the
    // wallpaper's top edge. Same construction as the pill - blurred, hairline,
    // lit top edge - but tinted DARK instead of light.
    //
    // The pill's glassFill is a light tint (232,238,245 @13%). Over a dark
    // wallpaper that reads as frosted glass; over a bright window it turns the
    // panel bright, and @wb-text-glass (#eef2f6) on top of it is unreadable.
    // Popouts hang over whatever happens to be below the bar, so they take a
    // dark tint at a weight that survives a white background.
    // SMOKED glass, not white glass.
    //
    // The bar's fill is a LIGHT tint (232,238,245 @13%). That works on a thin
    // pill, but across a 400px panel over a bright window it is mostly
    // background and reads as a white wash - cards on top then disappear into
    // it (white on white). Same construction as the bar - same hairline, same
    // inset highlight, same blur - with the tint darkened so the panel has its
    // own ground while staying see-through.
    //
    // useLightPanelTint: true restores the bar's exact fill.
    property bool useLightPanelTint: false
    property real panelAlpha: 0.38

    /// Every panel, popout and notification surface paints with this.
    readonly property color panelSurface: useLightPanelTint ? Qt.rgba(232 / 255, 238 / 255, 245 / 255, 0.13) : Qt.rgba(18 / 255, 20 / 255, 32 / 255, panelAlpha)

    // Inner card / text-backing layer. NOT white: the article's rule is
    // "opposite tones" - dark glass takes light text, so every layer stays on
    // the dark side. 0.18 sits inside the 10-30% tint range recommended for a
    // semi-opaque overlay behind text.
    //
    // This token was accidentally deleted when the panel block was rewritten,
    // and QML renders an undefined colour as WHITE - which is exactly how the
    // cards turned into white boxes.
    readonly property color cardLayer: Qt.rgba(0, 0, 0, 0.18)

    readonly property color glassPanel: panelSurface

    // Popup notifications carry no panel behind them, so they get the darker
    // fill instead of glassFill. Same value as @popup-fill in swaync/style.css.
    readonly property color popupFill: Qt.rgba(26 / 255, 28 / 255, 44 / 255, 0.78)
    readonly property color centerFill: Qt.rgba(21 / 255, 23 / 255, 38 / 255, 0.80)

    // ---- Metrics ----
    // Numbers come from configs/VB23 and Glass.css so the bar lands in exactly
    // the same place waybar put it.
    readonly property int barWidth: 1444       // VB23 "width"
    // waybar's strip was 36px tall with a 5px margin = 41px reserved, but GTK
    // needed that slack for its own box model. The pill here is only ~26px, so
    // 36 left visible dead space above and below it. These are sized to the
    // content instead: 26px pill + 2px breathing room each side.
    readonly property int barHeight: 28
    readonly property int barMarginTop: 3
    readonly property int barSpacing: 2        // VB23 says 4, but GTK added
                                               // its own box spacing on top of
                                               // it; 2 matches the result.

    // Comparison mode: while waybar was still running this pushed the bar one
    // bar-height lower so the two could be judged side by side. waybar is
    // retired now, so the bar sits in the top slot at VB23's own margin.
    // Set back to `barMarginTop + barHeight + 6` to run them side by side.
    property int barCompareOffset: 0

    readonly property int pillRadius: 14
    readonly property int pillPaddingH: 5
    readonly property int pillPaddingV: 2
    readonly property int pillMarginH: 8

    // ---- spacing scale, 4px grid (§5) ----
    readonly property int spaceXs: 4
    readonly property int spaceS: 8
    readonly property int spaceM: 12
    readonly property int spaceL: 16
    readonly property int spaceXl: 24

    readonly property int panelPadding: spaceL      // 16
    readonly property int cardPadding: spaceM       // 12
    readonly property int cardGap: spaceS           // 8
    readonly property int panelEdgeGap: 10          // from screen edge and bar

    // ---- panel sizes (§5) ----
    readonly property int dashboardWidth: 400
    readonly property int sidebarWidth: 340
    readonly property int launcherWidth: 500
    readonly property int sessionWidth: 84
    readonly property int osdWidth: 64

    // ---- pointer (§8) ----
    readonly property int hitTarget: 32
    readonly property int rowHeight: 44
    readonly property int edgeTriggerWidth: 4
    readonly property int edgeOpenDelay: 120
    readonly property int edgeCloseDelay: 250
    readonly property int popoutOpenDelay: 80
    readonly property int popoutCloseDelay: 250

    readonly property int panelRadius: 20
    readonly property int itemRadius: 10
    readonly property int itemPaddingH: 5
    readonly property int itemPaddingV: 3

    readonly property int popupRadius: 14
    readonly property int popupWidth: 350      // swaync notification-window-width
    readonly property int centerWidth: 330     // swaync control-center-width

    // ---- Type ----
    readonly property string fontFamily: "Maple Mono NF CN"
    // The ONLY permitted sizes (§4). Anything else needs sign-off.
    readonly property int fontMeta: 11       // meta, timestamps
    readonly property int fontSize: 12       // body
    readonly property int fontTitle: 14      // titles, list items
    readonly property int fontHeading: 18    // panel headings
    readonly property int fontBig: 28        // big numbers
    readonly property int fontClock: 44      // dashboard clock
    // Glass.css says font-weight: 500 (= Font.Medium). DemiBold reads closer
    // to what pango actually renders at 12px, where Qt's Medium comes out
    // noticeably lighter than GTK's.
    readonly property int fontWeight: Font.DemiBold

    // ---- Motion ----
    // DEPRECATED: motion now lives in Motion.qml / Anim.qml (§6). These remain
    // only for the bar, which is frozen pending a diff; nothing new may use
    // them.
    readonly property int animFast: 180
    readonly property int animNormal: 300
    readonly property int animDrawer: 500
}
