return {
  -- phpactor LSP
  {
    "neovim/nvim-lspconfig",
    opts = {
      servers = {
        phpactor = {
          root_dir = function(fname)
            return require("lspconfig.util").find_git_ancestor(fname) or vim.fn.getcwd()
          end,
        },
      },
    },
  },

  -- Treesitter: ensure PHP parser is installed
  {
    "nvim-treesitter/nvim-treesitter",
    opts = function(_, opts)
      vim.list_extend(opts.ensure_installed or {}, { "php", "phpdoc" })
    end,
  },

  -- none-ls: phpcs linting + phpcbf formatting with WordPress standard
  {
    "nvimtools/none-ls.nvim",
    optional = true,
    opts = function(_, opts)
      local nls = require("null-ls")
      opts.sources = opts.sources or {}
      vim.list_extend(opts.sources, {
        nls.builtins.diagnostics.phpcs.with({
          extra_args = { "--standard=WordPress" },
        }),
        nls.builtins.formatting.phpcbf.with({
          extra_args = { "--standard=WordPress" },
        }),
      })
    end,
  },
}
